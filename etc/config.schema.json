{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "chfuchte.aula_assistant.config.schema.json",
    "title": "ATec Aula Assistant Server configuration file schema",
    "description": "Schema for the configuration file of the ATec Aula Assistant Server",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "server": {
            "type": "object",
            "properties": {
                "port": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 65535
                },
                "corsOrigins": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "port"
            ],
            "additionalProperties": false
        },
        "audio": {
            "type": "object",
            "properties": {
                "x32": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 65535,
                            "default": 10023
                        }
                    },
                    "required": [
                        "host",
                        "port"
                    ],
                    "additionalProperties": false
                },
                "channel": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "path": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string",
                                "enum": [
                                    "microphone",
                                    "headset",
                                    "music",
                                    "jack",
                                    "audience",
                                    "mc",
                                    "lr"
                                ]
                            }
                        },
                        "required": [
                            "name",
                            "path",
                            "type"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": [
                "x32",
                "channel"
            ],
            "additionalProperties": false
        },
        "beamer": {
            "type": "object",
            "properties": {
                "ptmahdbt42": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        },
                        "port": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 65535,
                            "default": 80
                        }
                    },
                    "required": [
                        "host",
                        "port"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "ptmahdbt42"
            ],
            "additionalProperties": false
        },
        "lighting": {
            "type": "object",
            "properties": {
                "artnet": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string",
                            "default": "255.255.255.255"
                        },
                        "port": {
                            "type": "number",
                            "minimum": 1,
                            "maximum": 65535,
                            "default": 6454
                        },
                        "broadcast": {
                            "type": "boolean",
                            "default": true
                        }
                    },
                    "required": [],
                    "additionalProperties": false
                },
                "fixture_types": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_-]+$": {
                            "type": "object",
                            "patternProperties": {
                                "^[a-zA-Z0-9_-]+$": {
                                    "type": "string",
                                    "enum": [
                                        "generic",
                                        "red",
                                        "green",
                                        "blue",
                                        "white",
                                        "dimmer"
                                    ],
                                    "default": "generic"
                                }
                            },
                            "required": [],
                            "additionalProperties": false
                        }
                    },
                    "required": [],
                    "additionalProperties": false
                },
                "fixtures": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_-]+$": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string"
                                },
                                "universe": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 15
                                },
                                "start_address": {
                                    "type": "number",
                                    "minimum": 1,
                                    "maximum": 512
                                }
                            },
                            "required": [
                                "type",
                                "universe",
                                "start_address"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "required": [],
                    "additionalProperties": false
                },
                "scenes": {
                    "type": "object",
                    "patternProperties": {
                        "^[a-zA-Z0-9_-]+$": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "default",
                                        "power-on",
                                        "power-off",
                                        "colorpicker"
                                    ],
                                    "default": "default"
                                },
                                "reset": {
                                    "type": "boolean",
                                    "default": false
                                },
                                "values": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "fixture": {
                                                "type": "string"
                                            },
                                            "channel": {
                                                "type": "string"
                                            },
                                            "value": {
                                                "type": "number",
                                                "minimum": 0,
                                                "maximum": 255
                                            }
                                        },
                                        "required": [
                                            "fixture",
                                            "channel",
                                            "value"
                                        ],
                                        "additionalProperties": false
                                    }
                                }
                            },
                            "required": [
                                "type",
                                "reset",
                                "values"
                            ],
                            "additionalProperties": false
                        }
                    }
                }
            },
            "required": [
                "fixture_types",
                "fixtures",
                "scenes"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "server",
        "audio",
        "beamer",
        "lighting"
    ],
    "additionalProperties": false
}