{
    "name": "aula-assistant-server",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "start": "node dist/index.js",
        "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outdir=dist --packages=external",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "osc-min": "^2.1.2",
        "socket.io": "^4.8.3",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0"
    }
}
